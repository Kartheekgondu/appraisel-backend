# Render -> your Web Service -> Environment
# Use the Aiven MySQL connection details. Use the Aiven host and port,
# NOT localhost and NOT necessarily port 3306.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/appraisel_db?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=YOUR_AIVEN_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_AIVEN_PASSWORD

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_GMAIL_ADDRESS
SPRING_MAIL_PASSWORD=YOUR_NEW_GMAIL_APP_PASSWORD

FRONTEND_URL=https://YOUR-VERCEL-FRONTEND.vercel.app
