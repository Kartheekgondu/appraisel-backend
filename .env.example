# Example only. Configure actual values in Render -> Environment.
# DB_URL must point to a reachable hosted MySQL database; do not use localhost.
DB_URL=jdbc:mysql://YOUR-MYSQL-HOST:3306/YOUR_DATABASE?useSSL=true&requireSSL=true
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
