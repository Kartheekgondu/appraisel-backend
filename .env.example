# Render -> Web Service -> Environment
# Use your hosted MySQL provider's actual host, port, database, username and password.
# Never use localhost for the deployed database.
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_MYSQL_HOST:YOUR_MYSQL_PORT/appraisel_db?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=YOUR_MYSQL_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_MYSQL_PASSWORD

# Your Vercel production origin. Multiple origins may be comma-separated.
FRONTEND_URL=https://YOUR-VERCEL-PROJECT.vercel.app

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=YOUR_GMAIL_ADDRESS
SPRING_MAIL_PASSWORD=YOUR_NEW_GMAIL_APP_PASSWORD
